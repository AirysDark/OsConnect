#!/bin/sh

set -e

if [ "$1" = "configure" ]; then
    MAN=/usr/share/man
    BIN=/usr/bin
    SBIN=/usr/sbin
    LIB=/usr/lib/@DEB_HOST_MULTIARCH@
    update-alternatives --install \
       $SBIN/vncsession          vncsession      $SBIN/OsConnectsession 64 \
       --slave \
       $LIB/vncserver            vncserver       $LIB/OsConnectserver \
       --slave \
       $MAN/man8/vncsession.8.gz vncsession.8.gz $MAN/man8/OsConnectsession.8.gz \
       --slave \
       $MAN/man8/vncserver.8.gz  vncserver.8.gz  $MAN/man8/OsConnectserver.8.gz
    update-alternatives --install \
       $BIN/Xvnc            Xvnc            $BIN/XOsConnect 74 \
       --slave \
       $MAN/man1/Xvnc.1.gz  Xvnc.1.gz       $MAN/man1/XOsConnect.1.gz
    update-alternatives --install \
       $BIN/x0vncserver           x0vncserver     $BIN/x0OsConnectserver 74 \
       --slave \
       $MAN/man1/x0vncserver.1.gz x0vncserver.1.gz $MAN/man1/x0OsConnectserver.1.gz
    update-alternatives --install \
       $BIN/vncpasswd           vncpasswd            $BIN/OsConnectpasswd 74 \
       --slave \
       $MAN/man1/vncpasswd.1.gz vncpasswd.1.gz       $MAN/man1/OsConnectpasswd.1.gz
    update-alternatives --install \
       $BIN/vncconfig           vncconfig       $BIN/OsConnectconfig 64 \
       --slave \
       $MAN/man1/vncconfig.1.gz vncconfig.1.gz  $MAN/man1/OsConnectconfig.1.gz
fi

#DEBHELPER#

exit 0
